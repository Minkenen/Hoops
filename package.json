{
  "name": "hoops",
  "private": true,
  "version": "0.1.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:web": "VITE_TARGET=web VITE_MULTIPLAYER=1 tsc && VITE_TARGET=web VITE_MULTIPLAYER=1 vite build",
    "test:physics": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test test/physics.test.mjs test/world.test.mjs",
    "test:replay": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test test/shots.test.mjs test/replay.test.mjs test/client-replay.test.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test test/*.test.mjs server/leaderboard/test/*.test.mjs",
    "test:api": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test test/api.test.mjs test/match.test.mjs test/hub.test.mjs test/online-client.test.mjs"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
