{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hooperly",
  "version": "0.1.26",
  "identifier": "com.hoops.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzNDE1QjJEOEUxQkY5MUEKUldRYStSdU9MVnRCczEzOFJBaWlKL0M1RmhYb1hkYlJVcjBrRER6dUZpdC93SnlROTJXQkpveTMK",
      "endpoints": [
        "https://minkenen.github.io/Hooperly/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
